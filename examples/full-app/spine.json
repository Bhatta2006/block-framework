{
  "entities": [
    {
      "description": "App users (mirrors auth.users).",
      "fields": [
        { "default": "gen_random_uuid()", "name": "id", "primaryKey": true, "type": "uuid" },
        { "name": "email", "type": "text", "unique": true },
        { "default": "now()", "name": "created_at", "type": "timestamptz" }
      ],
      "name": "profiles"
    },
    {
      "description": "Habits tracked by a user.",
      "fields": [
        { "default": "gen_random_uuid()", "name": "id", "primaryKey": true, "type": "uuid" },
        { "name": "user_id", "references": "profiles.id", "type": "uuid" },
        { "name": "title", "type": "text" },
        { "name": "subtitle", "nullable": true, "type": "text" },
        { "default": "now()", "name": "created_at", "type": "timestamptz" }
      ],
      "name": "habits"
    },
    {
      "description": "Daily completion log for habits.",
      "fields": [
        { "default": "gen_random_uuid()", "name": "id", "primaryKey": true, "type": "uuid" },
        { "name": "habit_id", "references": "habits.id", "type": "uuid" },
        { "name": "completed_on", "type": "date" },
        { "default": "now()", "name": "created_at", "type": "timestamptz" }
      ],
      "name": "completions"
    }
  ]
}

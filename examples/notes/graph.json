{
  "schemaVersion": "0",
  "app": {
    "name": "Paper",
    "slug": "paper-notes",
    "version": "1.0.0",
    "layout": "notes",
    "theme": {
      "primaryColor": "#111111",
      "backgroundColor": "#FFFFFF",
      "textColor": "#141414"
    }
  },
  "screens": [
    {
      "id": "notes",
      "title": "All notes",
      "block": "collection",
      "blocks": ["summary", "collection"],
      "lane": "tabs"
    },
    {
      "id": "favorites",
      "title": "Favorites",
      "block": "favorites",
      "lane": "tabs"
    },
    {
      "id": "archive",
      "title": "Archive",
      "block": "archive",
      "lane": "tabs"
    },
    {
      "id": "trash",
      "title": "Trash",
      "block": "trash",
      "lane": "tabs"
    },
    {
      "id": "editor",
      "title": "Edit note",
      "block": "editor",
      "navigation": false
    }
  ],
  "blocks": [
    {
      "id": "summary",
      "type": "data.summary@1.0.0",
      "config": {
        "collectionKey": "notes"
      }
    },
    {
      "id": "collection",
      "type": "data.collection@1.0.0",
      "config": {
        "collectionKey": "notes",
        "title": "All notes",
        "seedRecords": [
          {
            "id": "welcome-note",
            "title": "A quieter place for your thoughts",
            "body": "# Welcome to Paper\n\nA simple space for ideas, plans, and everything worth keeping.\n\n**Make it yours.** Create a note, add a folder, and start writing.",
            "folder": "Inbox",
            "tags": ["welcome"]
          },
          {
            "id": "week-plan",
            "title": "A little structure for the week",
            "body": "# This week\n\n- [ ] Capture one good idea\n- [ ] Make time for a long walk\n- [ ] Finish something small",
            "folder": "Personal",
            "tags": ["planning"]
          },
          {
            "id": "project-ideas",
            "title": "Ideas worth exploring",
            "body": "The best ideas often arrive quietly.\n\nBuild something useful. Keep it simple. Leave room to grow.",
            "folder": "Work",
            "tags": ["ideas"]
          }
        ]
      }
    },
    {
      "id": "favorites",
      "type": "data.collection@1.0.0",
      "config": {
        "collectionKey": "notes",
        "title": "Favorites",
        "view": "favorites"
      }
    },
    {
      "id": "archive",
      "type": "data.collection@1.0.0",
      "config": {
        "collectionKey": "notes",
        "title": "Archive",
        "view": "archive"
      }
    },
    {
      "id": "trash",
      "type": "data.collection@1.0.0",
      "config": {
        "collectionKey": "notes",
        "title": "Trash",
        "view": "trash"
      }
    },
    {
      "id": "editor",
      "type": "data.editor@1.0.0",
      "config": {
        "collectionKey": "notes"
      }
    }
  ],
  "wires": [
    {
      "from": {
        "instance": "collection",
        "event": "data.recordSelected"
      },
      "to": {
        "screen": "editor",
        "instance": "editor",
        "port": "data.recordSelected"
      }
    },
    {
      "from": {
        "instance": "favorites",
        "event": "data.recordSelected"
      },
      "to": {
        "screen": "editor",
        "instance": "editor",
        "port": "data.recordSelected"
      }
    },
    {
      "from": {
        "instance": "archive",
        "event": "data.recordSelected"
      },
      "to": {
        "screen": "editor",
        "instance": "editor",
        "port": "data.recordSelected"
      }
    },
    {
      "from": {
        "instance": "trash",
        "event": "data.recordSelected"
      },
      "to": {
        "screen": "editor",
        "instance": "editor",
        "port": "data.recordSelected"
      }
    },
    {
      "from": {
        "instance": "editor",
        "event": "data.closed"
      },
      "to": {
        "screen": "notes"
      }
    }
  ]
}

{
  "description": "Block Framework M0 â€” deterministic block-based app compiler. JSON graph in, runnable Expo app out, zero AI involved.",
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.4",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.3",
    "@types/react-dom": "^19.2.3",
    "esbuild": "^0.28.2",
    "eslint": "10.12.0",
    "jsdom": "^30.1.2",
    "prettier": "3.9.9",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.1",
    "vitest": "5.0.3"
  },
  "engines": {
    "node": ">=20"
  },
  "name": "block-framework",
  "private": true,
  "scripts": {
    "build": "tsc -b tsconfig.json",
    "clean": "rm -rf node_modules package-lock.json packages/*/dist packages/*/tsconfig.tsbuildinfo",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "test": "vitest run",
    "typecheck": "tsc -b tsconfig.json && tsc --noEmit -p tsconfig.tests.json && npm run typecheck:ui --workspace=@blockfw/builder",
    "build:studio": "npm run build && npm run build --workspace=@blockfw/builder",
    "studio": "node packages/builder/dist/bin.js"
  },
  "type": "module",
  "version": "0.1.0",
  "workspaces": [
    "packages/*"
  ]
}

{
  "category": "paywall",
  "config": {
    "additionalProperties": false,
    "properties": {
      "ctaText": { "type": "string" },
      "headline": { "minLength": 1, "type": "string" },
      "products": {
        "items": {
          "additionalProperties": false,
          "properties": {
            "id": { "minLength": 1, "type": "string" },
            "period": { "minLength": 1, "type": "string" },
            "price": { "minLength": 1, "type": "string" },
            "title": { "minLength": 1, "type": "string" }
          },
          "required": ["id", "title", "price", "period"],
          "type": "object"
        },
        "maxItems": 4,
        "minItems": 1,
        "type": "array"
      },
      "subheadline": { "type": "string" }
    },
    "required": ["headline", "products"],
    "type": "object"
  },
  "defaultConfig": { "ctaText": "Subscribe" },
  "defaultVariant": "cards",
  "editSurface": ["src/blocks/<instance>.tsx"],
  "id": "paywall.basic",
  "locked": ["src/services/*", "src/navigation.tsx", "src/theme.ts"],
  "ports": {
    "consumes": ["paywall.show"],
    "emits": ["paywall.completed", "paywall.restored"],
    "provides": [{ "entity": "UserProfile.isPremium", "type": "boolean" }],
    "requires": [{ "entity": "BillingService", "optional": true }]
  },
  "variants": ["cards", "compact"],
  "version": "1.0.0"
}

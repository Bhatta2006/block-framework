{
  "$id": "https://blockfw.dev/schema/block-package-v2.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "description": "Source-vendored block package format v2, extending the existing contract.",
  "properties": {
    "backend": {
      "additionalProperties": false,
      "properties": {
        "routes": {
          "type": "array"
        },
        "tables": {
          "type": "array"
        }
      },
      "type": "object"
    },
    "category": {
      "enum": [
        "onboarding",
        "paywall",
        "home",
        "auth",
        "settings",
        "profile",
        "navigation",
        "theme",
        "data",
        "media",
        "social",
        "utility"
      ],
      "type": "string"
    },
    "config": {
      "description": "JSON Schema describing the block's user-editable configuration.",
      "type": "object"
    },
    "defaultConfig": {
      "type": "object"
    },
    "defaultVariant": {
      "type": "string"
    },
    "editSurface": {
      "description": "Config paths (e.g. config.headline) the scoped agent may edit. Empty means nothing is agent-editable.",
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "id": {
      "description": "Namespaced block id, e.g. onboarding.quiz",
      "pattern": "^[a-z][a-z0-9]*\\.[a-z][a-z0-9-]*$",
      "type": "string"
    },
    "locked": {
      "description": "File globs the agent must never touch.",
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "ports": {
      "additionalProperties": false,
      "properties": {
        "consumes": {
          "type": "array",
          "items": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "object",
                "required": ["port"],
                "properties": {
                  "port": {
                    "type": "string"
                  },
                  "accepts": {
                    "type": "object"
                  }
                },
                "additionalProperties": false
              }
            ]
          }
        },
        "emits": {
          "type": "array",
          "items": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "object",
                "required": ["event"],
                "properties": {
                  "event": {
                    "type": "string"
                  },
                  "payload": {
                    "type": "object"
                  }
                },
                "additionalProperties": false
              }
            ]
          }
        },
        "provides": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "entity": {
                "type": "string"
              },
              "type": {
                "type": "string"
              }
            },
            "required": ["entity"],
            "type": "object"
          },
          "type": "array"
        },
        "requires": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "entity": {
                "type": "string"
              },
              "optional": {
                "type": "boolean"
              }
            },
            "required": ["entity"],
            "type": "object"
          },
          "type": "array"
        }
      },
      "required": ["emits", "consumes"],
      "type": "object"
    },
    "slots": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "categories": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          }
        },
        "required": ["categories"]
      }
    },
    "variants": {
      "items": {
        "pattern": "^[a-z][a-z0-9-]*$",
        "type": "string"
      },
      "minItems": 1,
      "type": "array"
    },
    "version": {
      "description": "Semver. The compiler resolves instance types as id@version.",
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)$",
      "type": "string"
    },
    "formatVersion": {
      "const": 2
    },
    "targets": {
      "type": "array",
      "items": {
        "enum": ["web", "ios", "android", "server"]
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "license": {
      "type": "string",
      "minLength": 1
    },
    "stability": {
      "enum": ["experimental", "beta", "stable"]
    },
    "requires": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "services": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "entities": {
          "type": "object",
          "additionalProperties": {
            "type": "object"
          }
        },
        "blocks": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "env": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      },
      "required": ["services", "entities", "blocks", "env"]
    },
    "provides": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "entities": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "routes": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "flowSteps": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "events": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "slots": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      },
      "required": ["entities", "routes", "flowSteps", "events", "slots"]
    },
    "bindings": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "designTokens": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "permissions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "reads": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "writes": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      },
      "required": ["reads", "writes"]
    },
    "dependencies": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[A-Za-z0-9.-]+)?$"
      }
    },
    "implementations": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "web": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "entry": {
                  "type": "string"
                },
                "export": {
                  "type": "string",
                  "pattern": "^[A-Za-z_$][A-Za-z0-9_$]*$"
                }
              },
              "required": ["entry", "export"]
            },
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "adapter": {
                  "const": "legacy-template"
                }
              },
              "required": ["adapter"]
            }
          ]
        },
        "ios": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "entry": {
                  "type": "string"
                },
                "export": {
                  "type": "string",
                  "pattern": "^[A-Za-z_$][A-Za-z0-9_$]*$"
                }
              },
              "required": ["entry", "export"]
            },
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "adapter": {
                  "const": "legacy-template"
                }
              },
              "required": ["adapter"]
            }
          ]
        },
        "android": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "entry": {
                  "type": "string"
                },
                "export": {
                  "type": "string",
                  "pattern": "^[A-Za-z_$][A-Za-z0-9_$]*$"
                }
              },
              "required": ["entry", "export"]
            },
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "adapter": {
                  "const": "legacy-template"
                }
              },
              "required": ["adapter"]
            }
          ]
        },
        "server": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "entry": {
                  "type": "string"
                },
                "export": {
                  "type": "string",
                  "pattern": "^[A-Za-z_$][A-Za-z0-9_$]*$"
                }
              },
              "required": ["entry", "export"]
            },
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "adapter": {
                  "const": "legacy-template"
                }
              },
              "required": ["adapter"]
            }
          ]
        }
      }
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "target": {
            "type": "string",
            "minLength": 1
          },
          "platforms": {
            "type": "array",
            "items": {
              "enum": ["web", "ios", "android", "server"]
            },
            "minItems": 1,
            "uniqueItems": true
          }
        },
        "required": ["path", "target", "platforms"]
      },
      "minItems": 1
    }
  },
  "required": [
    "id",
    "version",
    "category",
    "variants",
    "config",
    "ports",
    "editSurface",
    "locked",
    "formatVersion",
    "targets",
    "license",
    "stability",
    "requires",
    "provides",
    "slots",
    "bindings",
    "designTokens",
    "permissions",
    "dependencies",
    "implementations",
    "files"
  ],
  "title": "BlockManifest v0",
  "type": "object"
}

{
  "$id": "https://blockfw.dev/schema/project-graph-v0.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "description": "The single source of truth for an app: screens in order, block instances, explicit wire overrides.",
  "properties": {
    "app": {
      "additionalProperties": false,
      "properties": {
        "cloud": {
          "type": "object",
          "additionalProperties": false,
          "required": ["provider"],
          "properties": {
            "provider": { "const": "supabase" },
            "backendUrl": { "type": "string", "maxLength": 2048, "pattern": "^(https://[^/?#@]+|http://(127\\.0\\.0\\.1|localhost)(:[0-9]+)?)/?$" }
          }
        },
        "name": {
          "minLength": 1,
          "type": "string"
        },
        "slug": {
          "pattern": "^[a-z][a-z0-9-]*$",
          "type": "string"
        },
        "theme": {
          "additionalProperties": false,
          "properties": {
            "backgroundColor": {
              "pattern": "^#[0-9a-fA-F]{6}$",
              "type": "string"
            },
            "primaryColor": {
              "pattern": "^#[0-9a-fA-F]{6}$",
              "type": "string"
            },
            "textColor": {
              "pattern": "^#[0-9a-fA-F]{6}$",
              "type": "string"
            }
          },
          "type": "object"
        },
        "version": {
          "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)$",
          "type": "string"
        },
        "dataId": {
          "type": "string",
          "minLength": 1
        },
        "layout": {
          "type": "string",
          "enum": ["standard", "notes"]
        }
      },
      "required": ["name", "slug", "version"],
      "type": "object"
    },
    "blocks": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "config": {
            "type": "object"
          },
          "id": {
            "pattern": "^[A-Za-z][A-Za-z0-9_-]*$",
            "type": "string"
          },
          "type": {
            "description": "Block type reference as id@semver, e.g. onboarding.quiz@1.0.0",
            "pattern": "^[a-z][a-z0-9]*\\.[a-z][a-z0-9-]*@[0-9]+\\.[0-9]+\\.[0-9]+$",
            "type": "string"
          },
          "variant": {
            "type": "string"
          },
          "position": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "x": {
                "type": "number"
              },
              "y": {
                "type": "number"
              }
            },
            "required": ["x", "y"]
          },
          "design": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "content": {
                "type": "array",
                "maxItems": 100,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["id", "type"],
                  "properties": {
                    "id": {
                      "type": "string",
                      "pattern": "^custom-[a-zA-Z0-9-]+$"
                    },
                    "type": {
                      "enum": ["button", "text", "divider"]
                    },
                    "text": {
                      "type": "string",
                      "maxLength": 4000
                    },
                    "before": {
                      "type": "string"
                    }
                  }
                }
              },
              "actions": {
                "type": "object",
                "propertyNames": {
                  "pattern": "^[a-zA-Z][a-zA-Z0-9-]*$"
                },
                "additionalProperties": {
                  "oneOf": [
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "required": ["type"],
                      "properties": {
                        "type": {
                          "enum": ["none", "back"]
                        }
                      }
                    },
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "required": ["type", "screen"],
                      "properties": {
                        "type": {
                          "const": "navigate"
                        },
                        "screen": {
                          "type": "string",
                          "minLength": 1
                        }
                      }
                    },
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "required": ["type", "url"],
                      "properties": {
                        "type": {
                          "const": "url"
                        },
                        "url": {
                          "type": "string",
                          "minLength": 1,
                          "pattern": "^https?://"
                        }
                      }
                    },
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "required": ["type", "message"],
                      "properties": {
                        "type": {
                          "const": "message"
                        },
                        "message": {
                          "type": "string",
                          "minLength": 1
                        }
                      }
                    }
                  ]
                }
              },
              "disconnectedEvents": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "string"
                }
              },
              "elements": {
                "type": "object",
                "propertyNames": {
                  "pattern": "^[a-zA-Z][a-zA-Z0-9-]*$"
                },
                "additionalProperties": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "x": {
                      "type": "number",
                      "minimum": -2000,
                      "maximum": 2000
                    },
                    "y": {
                      "type": "number",
                      "minimum": -2000,
                      "maximum": 2000
                    },
                    "width": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 2000
                    },
                    "height": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 2000
                    },
                    "padding": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 2000
                    },
                    "marginTop": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 2000
                    },
                    "marginBottom": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 2000
                    },
                    "borderRadius": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 2000
                    },
                    "fontSize": {
                      "type": "number",
                      "minimum": 8,
                      "maximum": 200
                    },
                    "fontWeight": {
                      "enum": ["400", "500", "600", "700", "800"]
                    },
                    "color": {
                      "type": "string",
                      "pattern": "^#[0-9a-fA-F]{6}$"
                    },
                    "backgroundColor": {
                      "type": "string",
                      "pattern": "^#[0-9a-fA-F]{6}$"
                    },
                    "opacity": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    },
                    "textAlign": {
                      "enum": ["left", "center", "right"]
                    },
                    "alignSelf": {
                      "enum": ["flex-start", "center", "flex-end", "stretch"]
                    },
                    "hidden": {
                      "type": "boolean"
                    }
                  }
                }
              }
            }
          }
        },
        "required": ["id", "type"],
        "type": "object"
      },
      "minItems": 1,
      "type": "array"
    },
    "schemaVersion": {
      "const": "0"
    },
    "screens": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "block": {
            "description": "Block instance id rendered on this screen.",
            "type": "string"
          },
          "id": {
            "pattern": "^[A-Za-z][A-Za-z0-9_-]*$",
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "lane": {
            "description": "Flow lane. Screens in the default \"main\" lane are reached via event wires; screens in other lanes (e.g. \"tabs\") are reachable outside the event flow (tab bar, drawer) and are not flagged as unreachable.",
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
          },
          "blocks": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "layout": {
            "enum": ["stack", "grid", "split"]
          },
          "position": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "x": {
                "type": "number"
              },
              "y": {
                "type": "number"
              }
            },
            "required": ["x", "y"]
          },
          "disconnectedLayout": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          },
          "navigation": {
            "type": "boolean"
          }
        },
        "required": ["id", "block", "title"],
        "type": "object"
      },
      "minItems": 1,
      "type": "array"
    },
    "wires": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "from": {
            "additionalProperties": false,
            "properties": {
              "event": {
                "type": "string"
              },
              "instance": {
                "type": "string"
              }
            },
            "required": ["instance", "event"],
            "type": "object"
          },
          "to": {
            "additionalProperties": false,
            "properties": {
              "screen": {
                "type": "string"
              },
              "instance": {
                "type": "string"
              },
              "port": {
                "type": "string"
              }
            },
            "required": ["screen"],
            "type": "object"
          }
        },
        "required": ["from", "to"],
        "type": "object"
      },
      "type": "array"
    }
  },
  "required": ["schemaVersion", "app", "screens", "blocks"],
  "title": "ProjectGraph v0",
  "type": "object"
}
